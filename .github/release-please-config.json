{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "onykia",
      "components": [
        "@mudomi/onykia-engine",
        "@mudomi/onykia-codemirror",
        "@mudomi/onykia-monaco"
      ]
    }
  ],
  "packages": {
    "packages/engine":     { "package-name": "@mudomi/onykia-engine" },
    "packages/codemirror": { "package-name": "@mudomi/onykia-codemirror" },
    "packages/monaco":     { "package-name": "@mudomi/onykia-monaco" }
  }
}
